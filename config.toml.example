# Gin Rummy Configuration
#
# This file is loaded automatically from these locations (in order):
#   1. ./config.toml (current working directory)
#   2. <package_dir>/config.toml (next to gin_rummy/)
#   3. ~/.config/gin_rummy/config.toml (user config directory)
#
# To customize: copy this file to one of the above locations and modify.

[logging]
# General logging level for the application.
# Options: DEBUG (most verbose), INFO, WARNING, ERROR (least verbose)
# At WARNING level, only warnings and errors are shown (quiet gameplay).
level = "WARNING"

# Python logging format string for log messages.
# %(name)s = logger name, %(levelname)s = level, %(message)s = the message
# See: https://docs.python.org/3/library/logging.html#logrecord-attributes
format = "%(name)s - %(levelname)s - %(message)s"

# Logging level specifically for AI decision messages (when show_ai_thinking is false).
# Set to "WARNING" to hide AI decisions (recommended for fair play).
# Set to "INFO" to see AI decisions on console.
# Note: show_ai_thinking in [display] overrides this to INFO when enabled.
ai_level = "WARNING"

# Optional file path for detailed logging.
# When set, all logs (including DEBUG level AI decisions) are written to this file.
# Useful for post-game analysis without spoiling gameplay.
# log_file = "game.log"

[game_rules]
# Maximum deadwood value allowed to knock.
# Standard gin rummy rules use 10. Lower values make knocking harder.
knock_threshold = 10

# Bonus points awarded for going gin (knocking with 0 deadwood).
# The winner gets this bonus plus the opponent's total deadwood.
gin_bonus = 25

# Bonus points awarded when the defender undercuts the knocker.
# An undercut occurs when the defender's deadwood is equal to or less than the knocker's.
# The defender gets this bonus plus the difference in deadwood.
undercut_bonus = 25

# When the deck has this many cards or fewer remaining, the round ends in a draw.
# Neither player scores. Standard rules typically use 2.
min_deck_cards = 2

# Score needed to win the game.
# First player to reach this score wins. Standard rules use 100.
target_score = 100

[ai]
# Strategy the AI uses to decide whether to knock.
# Options:
#   "always" - Knock whenever deadwood <= knock_threshold (aggressive)
#   "conservative" - Only knock when deadwood <= conservative_knock_threshold (cautious)
knock_strategy = "always"

# When knock_strategy is "conservative", the AI will only knock if deadwood
# is at or below this value. Ignored when knock_strategy is "always".
# Lower values = AI waits for a better hand before knocking.
conservative_knock_threshold = 5

# Minimum deadwood reduction required for AI to take a card from the discard pile.
# If taking the discard would reduce deadwood by less than this amount, AI draws from deck.
# Set to 1 to take any card that helps. Set higher to be more selective.
min_deadwood_improvement = 1

[display]
# Whether to clear the terminal screen between turns.
# Set to false to keep full game history visible (useful for debugging).
clear_screen = true

# Delay in seconds between AI actions (drawing, discarding, etc.).
# Makes AI turns easier to follow. Set to 0 for instant AI play.
ai_turn_delay = 0.5

# Show AI's decision reasoning in game output (draw choice, discard choice, knock decision).
# WARNING: This reveals opponent's deadwood and strategy - not recommended for fair play.
# When true, overrides ai_level to show INFO messages on console.
show_ai_thinking = false

[database]
# Whether to track game history in a SQLite database.
# When enabled, all games, hands, turns, and AI decisions are recorded.
# Useful for debugging, analyzing AI performance, and reviewing past games.
enabled = true

# Path to the SQLite database file.
# Can be absolute or relative to the current working directory.
# The file will be created automatically if it doesn't exist.
path = "game_history.db"

# Whether to record detailed AI decision reasoning.
# When true, stores why the AI made each draw/discard/knock decision.
# Increases database size but provides valuable debugging information.
track_ai_decisions = true

[assist]
# Training assist mode - shows helpful information during gameplay.

# Whether to display assist information (opponent pickups, dead cards).
# Set to false to play without any hints.
enabled = true

# Whether to show actual card values or just counts.
# When false: "Opponent picked up: 2 cards"
# When true: "Opponent picked up: 5♥, J♦"
# Can be toggled during gameplay by pressing 'a'.
show_values = false

[context_aware_ai]
# Configuration for ContextAwareAI - a smarter AI that adjusts strategy based on game state.
# All parameters are tunable for simulation-based optimization.

# Base draw threshold before modifiers are applied.
# This is the minimum deadwood improvement needed to take from discard pile.
base_draw_threshold = 1

# Outs calculation weights - higher values make those outs more attractive.
# Meld-completing outs: cards that complete a set or run (most valuable).
meld_completing_weight = 10.0

# Run-extending outs: cards that extend an existing 2-card run sequence.
run_extending_weight = 5.0

# Set-building outs: cards that create or extend pairs toward sets.
set_building_weight = 4.0

# Early game bonus for partial outs (run extending, set building).
# In early game, building toward melds is more valuable.
partial_meld_early_bonus = 2.0

# Game phase boundaries (fraction of deck remaining).
# Early game: partial outs get bonus weight.
early_game_threshold = 0.7

# Late game: only meld-completing outs matter much.
late_game_threshold = 0.3

# Dynamic threshold modifiers - how much context affects the threshold.
# Max reduction to threshold from deck running low (more desperate = lower threshold).
max_deck_modifier = 2.0

# Max increase to threshold from having many outs (can wait = higher threshold).
max_outs_modifier = 2.0

# Score differential thresholds for adjusting aggression.
# When trailing by this many points or more, play more aggressively.
trailing_aggressive_threshold = 50

# When leading by this many points or more, play more conservatively.
leading_conservative_threshold = 30

# Bonus adjustments for special situations.
# Extra "improvement" points for denying opponent a card they likely want.
denial_bonus = 2

# Opponent must want card with this probability to trigger denial bonus.
denial_probability_threshold = 0.7

# Whether to track opponent discard/pickup patterns for predictions.
track_opponent_patterns = true
